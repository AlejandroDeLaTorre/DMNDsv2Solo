# ~/.config/dmnd.env, used by dmnd-client and collector.py. chmod 600.
# DMND token from join.dmnd.work (also the Bitaxe password)
TOKEN=
# optional: the client's local API token (shows templates on the dashboard)
API_TX_TOKEN=
# optional: Bitcoin Core RPC, for the relay-policy and transaction-type sections
RPC_URL=http://127.0.0.1:8332
RPC_USER=
RPC_PWD=
# optional: turns on RSK merge mining (see GUIDE.md, "Optional: also mine RSK"). Use a long random string.
API_SECRET=
# keep the client API on this machine when API_SECRET is set
API_BIND_ADDRESS=127.0.0.1
